# Public site URL used for SEO metadata, canonical URLs, hreflang and sitemap.
# En Vercel Production se usa siempre https://sideglass.moisesvalero.es (ver lib/site.ts).
# En preview/local puedes apuntar al dominio de preview si lo necesitas.
NEXT_PUBLIC_SITE_URL=https://sideglass.moisesvalero.es

# Optional: legacy OpenWeather key (not required — app uses Open-Meteo by default)
# NEXT_PUBLIC_OPENWEATHER_KEY=
