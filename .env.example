# OpenWeatherMap API key (free tier)
# Get yours at: https://openweathermap.org/api
NEXT_PUBLIC_OPENWEATHER_KEY=

# Google Calendar integration
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create API key with Calendar API enabled
# 3. Make your calendar public in Google Calendar settings
# 4. Copy the Calendar ID from Settings > Integrate calendar
NEXT_PUBLIC_GOOGLE_CALENDAR_KEY=
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=
