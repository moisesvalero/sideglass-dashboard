{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sideglass",
  "version": "0.2.32",
  "identifier": "com.deskdashboard.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:3000/dashboard",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "/dashboard",
        "title": "Sideglass",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": false,
        "maximized": true,
        "minWidth": 360,
        "minHeight": 600,
        "maximizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/moisesvalero/sideglass-dashboard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1ODRFRDU0RTlCRUUzMDcKUldRSDQ3N3BWTzJFMWJ4SVhveFZEdlR2VnpBN0l5Qm5JR1hpYTRDLzNmV1ZIMEJNZzM0RFd1NVIK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": ["bin/*", "bin/**/*"]
  }
}
